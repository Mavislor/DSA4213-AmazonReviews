    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1Uak21PiUb79",
        "outputId": "7ebf70d1-b687-44a2-c489-3abf2c158017"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "(7484, 2)\n",
            "   label                                             review\n",
            "0      0  Howlingly Horrible: This was one of the most e...\n",
            "1      1  Shocking for its time: This movie about a bunc...\n",
            "2      1  Bowie keeps on getting better and better: Davi...\n",
            "3      1  Meryl Streep is Great: Great movie for it's ti...\n",
            "4      0  Not what I expected: I purchased this for my g...\n"
          ]
        }
      ],
      "source": [
        "test_df = pd.read_csv(\"test.csv\")\n",
        "print(test_df.shape)\n",
        "\n",
        "# Convert string labels to binary labels\n",
        "label_to_id_map = {\"negative\": 0, \"positive\": 1}\n",
        "id_to_label_map = {0: \"negative\", 1: \"positive\"}\n",
        "test_df[\"label\"] = test_df[\"label\"].map(label_to_id_map)\n",
        "print(test_df.head())"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "UVToDCzJ_kY3"
      },
      "source": [
        "Tokenize text"
